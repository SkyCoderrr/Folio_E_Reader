  "lineHeightPx": 35,
  "marginXPx": 48,
  "marginYPx": 40,
  "maxLineWidthPx": 720,
  "pageGapPx": 48,
}
`;

exports[`builtin.sepia > snapshots minimal override 1`] = `
{
  "background": "#F3EAD7",
  "css": "html, body {
  background-color: #F3EAD7 !important;
  color: #3A2F23 !important;
}

body { hyphens: auto; }

body * { color: #3A2F23 !important; background-color: transparent !important; }

body a:any-link, body a:any-link * { color: #8A4B14 !important; }

::selection { background-color: #8A4B1452 !important; color: #3A2F23 !important; }

html, body, body *, body *::before, body *::after {
  columns: auto !important;
  column-count: 1 !important;
  column-width: auto !important;
  column-span: none !important;
}

body :where(:lang(zh), :lang(ja), :lang(ko)), body:where(:lang(zh), :lang(ja), :lang(ko)) {
  line-break: strict;
  word-break: normal;
  overflow-wrap: anywhere;
  text-justify: inter-character;
}

body :where(:lang(zh), :lang(ja), :lang(ko)), body:where(:lang(zh), :lang(ja), :lang(ko)) { text-spacing-trim: trim-start; }

body :where(:lang(zh), :lang(ja), :lang(ko)), body:where(:lang(zh), :lang(ja), :lang(ko)) { text-autospace: normal; }
",
  "fontSizePx": 20,
  "foreground": "#3A2F23",
  "lineHeightPx": 35,
  "marginXPx": 48,
  "marginYPx": 40,
  "maxLineWidthPx": 720,
  "pageGapPx": 48,
}
`;
